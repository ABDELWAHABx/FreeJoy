{
    "name": "freejoy-server",
    "version": "2.0.0",
    "description": "TypeScript Server for FreeJoy - DIY Gamepad Controller",
    "main": "dist/server.js",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "start": "tsx src/server.ts",
        "build": "tsc && node scripts/copy-runtime-assets.mjs",
        "build:client": "npm --prefix ../client ci && npm --prefix ../client run build",
        "dev": "tsx watch src/server.ts",
        "prod": "node dist/server.js",
        "prepack": "npm run build:client && npm run build",
        "package:smoke": "node scripts/package-smoke.mjs",
        "test": "tsx --test test/authority.test.ts test/protocol.test.ts test/roomManager.test.ts test/wsHandler.integration.test.ts"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "socket.io": "^4.8.4",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "socket.io-client": "^4.8.4",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
